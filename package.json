{
  "name": "server-devtools",
  "version": "0.1.1",
  "description": "Chrome DevTools for your backend. Inspect HTTP requests, database operations, outbound calls, errors, and execution timing from an embedded dashboard.",
  "license": "Apache-2.0",
  "author": "Godwin Ehikhamhen",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./nestjs": {
      "types": "./dist/src/nestjs.d.ts",
      "require": "./dist/src/nestjs.js",
      "default": "./dist/src/nestjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:sdk": "tsc -p tsconfig.build.json && node scripts/finalize-commonjs-entry.cjs",
    "build:dashboard": "npm --prefix dashboard run build",
    "build": "npm run clean && npm run build:sdk && npm run build:dashboard",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "keywords": [
    "nodejs",
    "debugging",
    "devtools",
    "backend",
    "opentelemetry",
    "observability",
    "tracing",
    "express",
    "nestjs",
    "mongodb"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-mongodb": "^0.74.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
